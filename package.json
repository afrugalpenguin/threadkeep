{
  "name": "hansard-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "afrugalpenguin",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/cli packages/server && tsc --noEmit -p packages/server/tsconfig.client.json && tsc --noEmit -p tsconfig.json",
    "hygiene": "node scripts/check-hygiene.mjs --tracked",
    "hygiene:history": "node scripts/check-hygiene.mjs --history"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "lefthook": "^1.11.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
